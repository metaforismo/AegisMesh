EncryptedFrameLength(reader, segment, frameNumber)
+		if err != nil {
+			return 0, err
+		}
+		if done {
+			return count, nil
+		}
+		if _, err := io.CopyN(io.Discard, reader, int64(length)); err != nil {
+			return 0, fmt.Errorf("%w: encrypted segment %s frame %d is truncated", errStore, segment, frameNumber)
+		}
+		count++
+	}
+}
+
+func readEncryptedSegmentHeader(reader *bufio.Reader, segment string) error {
+	magic := make([]byte, len(encryptedSegmentMagic))
+	if _, err := io.ReadFull(reader, magic); err != nil {
+		return fmt.Errorf("%w: encrypted segment %s has a truncated header", errStore, segment)
+	}
+	if string(magic) != encryptedSegmentMagic {
+		return fmt.Errorf("%w: encrypted segment %s has an unsupported framing header", errStore, segment)
+	}
+	return nil
+}
+
+func readEncryptedFrameLength(reader *bufio.Reader, segment string, frameNumber int) (uint32, bool, error) {
+	var prefix [frameLengthBytes]byte
+	n, err := io.ReadFull(reader, prefix[:])
+	if errors.Is(err, io.EOF) && n == 0 {
+		return 0, true, nil
+	}
+	if err != nil {
+		return 0, false, fmt.Errorf("%w: encrypted segment %s frame %d has a truncated length prefix", errStore, segment, frameNumber)
+	}
+	length := binary.BigEndian.Uint32(prefix[:])
+	if length == 0 || length > agekey.MaxEncryptedFrameBytes {
+		return 0, false, fmt.Errorf("%w: encrypted segment %s frame %d has invalid length %d", errStore, segment, frameNumber, length)
+	}
+	return length, false, nil
+}
