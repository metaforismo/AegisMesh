+	enc := storage.Encryption
+	if !enc.Enabled {
+		if enc.Recipient != "" {
+			return fmt.Errorf("recipient requires enabled: true")
+		}
+		return nil
+	}
+	if _, err := agekey.ParseRecipient(enc.Recipient); err != nil {
+		return err
+	}
+	return nil
+}
